[
  {
    "text": "太陡了",
    "start": 7.821,
    "end": 9.021,
    "speaker": "邱",
    "shot": "04"
  },
  {
    "text": "算了",
    "start": 9.071,
    "end": 9.941,
    "speaker": "邱",
    "shot": "04"
  },
  {
    "text": "秀秀智能轮椅",
    "start": 12.082,
    "end": 13.442,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "新品上市",
    "start": 13.462,
    "end": 14.442,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "过台阶",
    "start": 14.792,
    "end": 15.882,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "走窄路",
    "start": 15.932,
    "end": 16.702,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "一个人也能轻松出门",
    "start": 16.952,
    "end": 18.942,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "你都到了",
    "start": 36.754,
    "end": 37.914,
    "speaker": "徐",
    "shot": "19"
  },
  {
    "text": "给谁做",
    "start": 39.125,
    "end": 39.505,
    "speaker": "徐",
    "shot": "20"
  },
  {
    "text": "给我",
    "start": 39.75,
    "end": 40.755,
    "speaker": "邱",
    "shot": "20"
  },
  {
    "text": "你看这颜色",
    "start": 41.03,
    "end": 42.415,
    "speaker": "邱",
    "shot": "20"
  },
  {
    "text": "这个好",
    "start": 45.395,
    "end": 46.575,
    "speaker": "邱",
    "shot": "22"
  },
  {
    "text": "老板",
    "start": 50.768,
    "end": 51.458,
    "speaker": "来客",
    "shot": "24"
  },
  {
    "text": "你这儿怎么进去啊",
    "start": 51.508,
    "end": 52.808,
    "speaker": "来客",
    "shot": "24"
  },
  {
    "text": "旁边有个坡",
    "start": 54.224,
    "end": 55.334,
    "speaker": "店主",
    "shot": "26"
  },
  {
    "text": "这坡我上不了",
    "start": 56.284,
    "end": 57.494,
    "speaker": "来客",
    "shot": "26"
  },
  {
    "text": "秀秀",
    "start": 59.752,
    "end": 60.412,
    "speaker": "邱",
    "shot": "27"
  },
  {
    "text": "这条消息你发的",
    "start": 60.672,
    "end": 62.202,
    "speaker": "邱",
    "shot": "27"
  },
  {
    "text": "刚才进店时发的",
    "start": 62.738,
    "end": 64.358,
    "speaker": "秀秀",
    "shot": "28"
  },
  {
    "text": "她的轮椅上不来",
    "start": 66.743,
    "end": 68.268,
    "speaker": "邱",
    "shot": "29"
  },
  {
    "text": "得把台阶写上",
    "start": 68.548,
    "end": 70.208,
    "speaker": "邱",
    "shot": "29"
  },
  {
    "text": "别让人白跑",
    "start": 70.318,
    "end": 71.478,
    "speaker": "邱",
    "shot": "29"
  },
  {
    "text": "好",
    "start": 71.768,
    "end": 72.148,
    "speaker": "秀秀",
    "shot": "29"
  },
  {
    "text": "我改",
    "start": 72.428,
    "end": 72.978,
    "speaker": "秀秀",
    "shot": "29"
  },
  {
    "text": "这两处可以报给街道",
    "start": 78.528,
    "end": 80.398,
    "speaker": "秀秀",
    "shot": "31"
  },
  {
    "text": "附上照片",
    "start": 80.428,
    "end": 81.348,
    "speaker": "秀秀",
    "shot": "31"
  },
  {
    "text": "要报吗",
    "start": 81.578,
    "end": 82.498,
    "speaker": "秀秀",
    "shot": "31"
  },
  {
    "text": "都报吧",
    "start": 83.228,
    "end": 84.198,
    "speaker": "邱",
    "shot": "31"
  },
  {
    "text": "看看能不能修",
    "start": 84.458,
    "end": 85.758,
    "speaker": "邱",
    "shot": "31"
  },
  {
    "text": "这两根柱子挪一下",
    "start": 103.391,
    "end": 104.946,
    "speaker": "工作人员",
    "shot": "42"
  },
  {
    "text": "去车站就不用绕了",
    "start": 105.741,
    "end": 108.001,
    "speaker": "工作人员",
    "shot": "42"
  },
  {
    "text": "这回行了吧",
    "start": 119.04,
    "end": 120.12,
    "speaker": "店主",
    "shot": "52"
  },
  {
    "text": "让她也试试",
    "start": 120.62,
    "end": 121.93,
    "speaker": "邱",
    "shot": "52"
  },
  {
    "text": "这里转不过来",
    "start": 128.007,
    "end": 129.277,
    "speaker": "来客",
    "shot": "53"
  },
  {
    "text": "这袖子好看",
    "start": 158.917,
    "end": 160.487,
    "speaker": "徐",
    "shot": "69"
  },
  {
    "text": "转过去",
    "start": 161.415,
    "end": 162.13,
    "speaker": "徐",
    "shot": "70"
  },
  {
    "text": "我看看后面",
    "start": 162.165,
    "end": 163.295,
    "speaker": "徐",
    "shot": "70"
  }
]