        543,
        136,
        569.98
      ],
      "text": "O6"
    },
    {
      "page": 10,
      "rect": [
        150,
        543,
        480,
        577.08
      ],
      "text": "考核只看局部结果"
    },
    {
      "page": 10,
      "rect": [
        503,
        543,
        1203,
        572.82
      ],
      "text": "记录本次通行和少争执，缺少同一人的连续漏乘和实际等待。"
    },
    {
      "page": 10,
      "rect": [
        64,
        679,
        1154,
        697.46
      ],
      "text": "以上为本作品设定；不是现实医院规章，也不是某款轮椅的已部署功能。"
    },
    {
      "page": 11,
      "rect": [
        64,
        34,
        1164,
        55.3
      ],
      "text": "通过行动表现，而不是给它打“礼貌分”"
    },
    {
      "page": 11,
      "rect": [
        64,
        66,
        1216,
        117.12
      ],
      "text": "小椅要学会的修养"
    },
    {
      "page": 11,
      "rect": [
        1180,
        677,
        1220,
        696.88
      ],
      "text": "11"
    },
    {
      "page": 11,
      "rect": [
        64,
        159,
        604,
        200.18
      ],
      "text": "安全地争取"
    },
    {
      "page": 11,
      "rect": [
        64,
        224,
        604,
        292.15999999999997
      ],
      "text": "她先到，可以替她说。\n有人进入路径，仍要停下。"
    },
    {
      "page": 11,
      "rect": [
        652,
        159,
        1192,
        200.18
      ],
      "text": "重新问这一次"
    },
    {
      "page": 11,
      "rect": [
        652,
        224,
        1192,
        292.15999999999997
      ],
      "text": "设备回复不替代本人同意。\n历史偏好不能压过当前拒绝。"
    },
    {
      "page": 11,
      "rect": [
        64,
        377,
        604,
        418.18
      ],
      "text": "承认代价来自谁"
    },
    {
      "page": 11,
      "rect": [
        64,
        442,
        604,
        510.15999999999997
      ],
      "text": "撤回安排，不另找更好说话的人。\n向实际有权限的人继续求助。"
    },
    {
      "page": 11,
      "rect": [
        652,
        377,
        1192,
        418.18
      ],
      "text": "让一次保持为一次"
    },
    {
      "page": 11,
      "rect": [
        652,
        442,
        1192,
        510.15999999999997
      ],
      "text": "尊重“不保存”。\n不把体谅训练成长期义务。"
    },
    {
      "page": 11,
      "rect": [
        64,
        609,
        1216,
        641.66
      ],
      "text": "林岚可能迟到，对方可以拒绝。修养并不保证主人每次都赢。"
    },
    {
      "page": 11,
      "rect": [
        64,
        679,
        1154,
        697.46
      ],
      "text": "机构仍需修改请求入口、连续漏乘记录、授权范围和考核方式。"
    },
    {
      "page": 12,
      "rect": [
        64,
        34,
        1164,
        55.3
      ],
      "text": "多国调研 1/2"
