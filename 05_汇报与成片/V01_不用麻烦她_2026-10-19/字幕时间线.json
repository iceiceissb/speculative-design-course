[
  {
    "text": "太陡了",
    "start": 11.279,
    "end": 12.479,
    "speaker": "邱",
    "shot": "04"
  },
  {
    "text": "算了",
    "start": 12.529,
    "end": 13.399,
    "speaker": "邱",
    "shot": "04"
  },
  {
    "text": "这几个行吗",
    "start": 13.868,
    "end": 15.288,
    "speaker": "店主",
    "shot": "05"
  },
  {
    "text": "里面那排",
    "start": 17.498,
    "end": 18.458,
    "speaker": "邱",
    "shot": "05"
  },
  {
    "text": "还有别的吗",
    "start": 18.493,
    "end": 19.75,
    "speaker": "邱",
    "shot": "05"
  },
  {
    "text": "你先去接孩子",
    "start": 21.232,
    "end": 22.722,
    "speaker": "邱",
    "shot": "06"
  },
  {
    "text": "我再看看",
    "start": 23.172,
    "end": 24.062,
    "speaker": "邱",
    "shot": "06"
  },
  {
    "text": "到家给我发个消息",
    "start": 24.858,
    "end": 26.348,
    "speaker": "徐",
    "shot": "07"
  },
  {
    "text": "秀秀智能轮椅",
    "start": 31.957,
    "end": 33.317,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "新品上市",
    "start": 33.337,
    "end": 34.317,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "过台阶",
    "start": 34.667,
    "end": 35.757,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "走窄路",
    "start": 35.807,
    "end": 36.577,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "一个人也能轻松出门",
    "start": 36.827,
    "end": 38.817,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "你都到了",
    "start": 67.296,
    "end": 68.456,
    "speaker": "徐",
    "shot": "19"
  },
  {
    "text": "给谁做",
    "start": 69.667,
    "end": 70.047,
    "speaker": "徐",
    "shot": "20"
  },
  {
    "text": "给我",
    "start": 70.292,
    "end": 71.297,
    "speaker": "邱",
    "shot": "20"
  },
  {
    "text": "你看这颜色",
    "start": 71.572,
    "end": 72.957,
    "speaker": "邱",
    "shot": "20"
  },
  {
    "text": "这个好",
    "start": 78.228,
    "end": 79.408,
    "speaker": "邱",
    "shot": "22"
  },
  {
    "text": "老板",
    "start": 85.393,
    "end": 86.083,
    "speaker": "来客",
    "shot": "24"
  },
  {
    "text": "你这儿怎么进去啊",
    "start": 86.133,
    "end": 87.433,
    "speaker": "来客",
    "shot": "24"
  },
  {
    "text": "旁边有个坡",
    "start": 89.765,
    "end": 90.875,
    "speaker": "店主",
    "shot": "26"
  },
  {
    "text": "这坡我上不了",
    "start": 91.825,
    "end": 93.035,
    "speaker": "来客",
    "shot": "26"
  },
  {
    "text": "秀秀",
    "start": 95.294,
    "end": 95.954,
    "speaker": "邱",
    "shot": "27"
  },
  {
    "text": "这条消息你发的",
    "start": 96.214,
    "end": 97.744,
    "speaker": "邱",
    "shot": "27"
  },
  {
    "text": "刚才进店时发的",
    "start": 98.28,
    "end": 99.9,
    "speaker": "秀秀",
    "shot": "28"
  },
  {
    "text": "她的轮椅上不来",
    "start": 102.285,
    "end": 103.81,
    "speaker": "邱",
    "shot": "29"
  },
  {
    "text": "得把台阶写上",
    "start": 104.09,
    "end": 105.75,
    "speaker": "邱",
    "shot": "29"
  },
  {
    "text": "别让人白跑",
    "start": 105.86,
    "end": 107.02,
    "speaker": "邱",
    "shot": "29"
  },
  {
    "text": "好",
    "start": 107.31,
    "end": 107.69,
    "speaker": "秀秀",
    "shot": "29"
  },
  {
    "text": "我改",
    "start": 107.97,
    "end": 108.52,
    "speaker": "秀秀",
    "shot": "29"
  },
  {
    "text": "这两处可以报给街道",
    "start": 115.403,
    "end": 117.273,
    "speaker": "秀秀",
    "shot": "31"
  },
  {
    "text": "附上照片",
    "start": 117.303,
    "end": 118.223,
    "speaker": "秀秀",
    "shot": "31"
  },
  {
    "text": "要报吗",
    "start": 118.453,
    "end": 119.373,
    "speaker": "秀秀",
    "shot": "31"
  },
  {
    "text": "都报吧",
    "start": 120.103,
    "end": 121.073,
    "speaker": "邱",
    "shot": "31"
  },
  {
    "text": "看看能不能修",
    "start": 121.333,
    "end": 122.633,
    "speaker": "邱",
    "shot": "31"
  },
  {
    "text": "老板",
    "start": 126.957,
    "end": 127.677,
    "speaker": "来客",
    "shot": "33"
  },
  {
    "text": "样布先拿出来吧",
    "start": 127.677,
    "end": 128.997,
    "speaker": "来客",
    "shot": "33"
  },
  {
    "text": "我自己挑",
    "start": 129.007,
    "end": 129.757,
    "speaker": "来客",
    "shot": "33"
  },
  {
    "text": "我店里好像有把尺",
    "start": 132.353,
    "end": 133.868,
    "speaker": "店主",
    "shot": "34"
  },
  {
    "text": "我这儿有",
    "start": 133.903,
    "end": 134.763,
    "speaker": "邱",
    "shot": "34"
  },
  {
    "text": "快去吧",
    "start": 139.112,
    "end": 140.052,
    "speaker": "邱",
    "shot": "36"
  },
  {
    "text": "别迟了",
    "start": 140.082,
    "end": 141.012,
    "speaker": "邱",
    "shot": "36"
  },
  {
    "text": "这两根柱子挪一下",
    "start": 160.933,
    "end": 162.488,
    "speaker": "工作人员",
    "shot": "42"
  },
  {
    "text": "去车站就不用绕了",
    "start": 163.283,
    "end": 165.543,
    "speaker": "工作人员",
    "shot": "42"
  },
  {
    "text": "这回行了吧",
    "start": 190.582,
    "end": 191.662,
    "speaker": "店主",
    "shot": "52"
  },
  {
    "text": "让她也试试",
    "start": 192.162,
    "end": 193.472,
    "speaker": "邱",
    "shot": "52"
  },
  {
    "text": "这里转不过来",
    "start": 199.548,
    "end": 200.818,
    "speaker": "来客",
    "shot": "53"
  },
  {
    "text": "今天不用接孩子",
    "start": 248.934,
    "end": 250.694,
    "speaker": "邱",
    "shot": "68"
  },
  {
    "text": "今天他爸接",
    "start": 250.849,
    "end": 252.434,
    "speaker": "徐",
    "shot": "68"
  },
  {
    "text": "这袖子好看",
    "start": 253.0,
    "end": 254.57,
    "speaker": "徐",
    "shot": "69"
  },
  {
    "text": "转过去",
    "start": 257.648,
    "end": 258.48299999999995,
    "speaker": "徐",
    "shot": "70"
  },
  {
    "text": "我看看后面",
    "start": 258.518,
    "end": 259.668,
    "speaker": "徐",
    "shot": "70"
  }
]