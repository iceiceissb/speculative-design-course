[
  {
    "text": "太陡了",
    "start": 12.487,
    "end": 13.687,
    "speaker": "邱",
    "shot": "04"
  },
  {
    "text": "算了",
    "start": 13.737,
    "end": 14.607,
    "speaker": "邱",
    "shot": "04"
  },
  {
    "text": "这几个行吗",
    "start": 15.077,
    "end": 16.497,
    "speaker": "店主",
    "shot": "05"
  },
  {
    "text": "里面那排",
    "start": 18.707,
    "end": 19.667,
    "speaker": "邱",
    "shot": "05"
  },
  {
    "text": "还有别的吗",
    "start": 19.702,
    "end": 20.958,
    "speaker": "邱",
    "shot": "05"
  },
  {
    "text": "你先去接孩子",
    "start": 22.44,
    "end": 23.93,
    "speaker": "邱",
    "shot": "06"
  },
  {
    "text": "我再看看",
    "start": 24.38,
    "end": 25.27,
    "speaker": "邱",
    "shot": "06"
  },
  {
    "text": "到家给我发个消息",
    "start": 26.067,
    "end": 27.557,
    "speaker": "徐",
    "shot": "07"
  },
  {
    "text": "秀秀智能轮椅",
    "start": 33.165,
    "end": 34.525,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "新品上市",
    "start": 34.545,
    "end": 35.525,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "过台阶",
    "start": 35.875,
    "end": 36.965,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "走窄路",
    "start": 37.015,
    "end": 37.785,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "一个人也能轻松出门",
    "start": 38.035,
    "end": 40.025,
    "speaker": "广告声",
    "shot": "09"
  },
  {
    "text": "你都到了",
    "start": 69.296,
    "end": 70.456,
    "speaker": "徐",
    "shot": "19"
  },
  {
    "text": "给谁做",
    "start": 71.667,
    "end": 72.047,
    "speaker": "徐",
    "shot": "20"
  },
  {
    "text": "给我",
    "start": 72.292,
    "end": 73.297,
    "speaker": "邱",
    "shot": "20"
  },
  {
    "text": "你看这颜色",
    "start": 73.572,
    "end": 74.957,
    "speaker": "邱",
    "shot": "20"
  },
  {
    "text": "这个好",
    "start": 80.228,
    "end": 81.408,
    "speaker": "邱",
    "shot": "22"
  },
  {
    "text": "老板",
    "start": 87.393,
    "end": 88.083,
    "speaker": "来客",
    "shot": "24"
  },
  {
    "text": "你这儿怎么进去啊",
    "start": 88.133,
    "end": 89.433,
    "speaker": "来客",
    "shot": "24"
  },
  {
    "text": "旁边有个坡",
    "start": 91.765,
    "end": 92.875,
    "speaker": "店主",
    "shot": "26"
  },
  {
    "text": "这坡我上不了",
    "start": 93.825,
    "end": 95.035,
    "speaker": "来客",
    "shot": "26"
  },
  {
    "text": "秀秀",
    "start": 97.294,
    "end": 97.954,
    "speaker": "邱",
    "shot": "27"
  },
  {
    "text": "这条消息你发的",
    "start": 98.214,
    "end": 99.744,
    "speaker": "邱",
    "shot": "27"
  },
  {
    "text": "刚才进店时发的",
    "start": 100.28,
    "end": 101.9,
    "speaker": "秀秀",
    "shot": "28"
  },
  {
    "text": "她的轮椅上不来",
    "start": 104.285,
    "end": 105.81,
    "speaker": "邱",
    "shot": "29"
  },
  {
    "text": "得把台阶写上",
    "start": 106.09,
    "end": 107.75,
    "speaker": "邱",
    "shot": "29"
  },
  {
    "text": "别让人白跑",
    "start": 107.86,
    "end": 109.02,
    "speaker": "邱",
    "shot": "29"
  },
  {
    "text": "好",
    "start": 109.31,
    "end": 109.69,
    "speaker": "秀秀",
    "shot": "29"
  },
  {
    "text": "我改",
    "start": 109.97,
    "end": 110.52,
    "speaker": "秀秀",
    "shot": "29"
  },
  {
    "text": "这两处可以报给街道",
    "start": 117.403,
    "end": 119.273,
    "speaker": "秀秀",
    "shot": "31"
  },
  {
    "text": "附上照片",
    "start": 119.303,
    "end": 120.223,
    "speaker": "秀秀",
    "shot": "31"
  },
  {
    "text": "要报吗",
    "start": 120.453,
    "end": 121.373,
    "speaker": "秀秀",
    "shot": "31"
  },
  {
    "text": "都报吧",
    "start": 122.103,
    "end": 123.073,
    "speaker": "邱",
    "shot": "31"
  },
  {
    "text": "看看能不能修",
    "start": 123.333,
    "end": 124.633,
    "speaker": "邱",
    "shot": "31"
  },
  {
    "text": "老板",
    "start": 128.957,
    "end": 129.677,
    "speaker": "来客",
    "shot": "33"
  },
  {
    "text": "样布先拿出来吧",
    "start": 129.677,
    "end": 130.997,
    "speaker": "来客",
    "shot": "33"
  },
  {
    "text": "我自己挑",
    "start": 131.007,
    "end": 131.757,
    "speaker": "来客",
    "shot": "33"
  },
  {
    "text": "我店里好像有把尺",
    "start": 134.353,
    "end": 135.868,
    "speaker": "店主",
    "shot": "34"
  },
  {
    "text": "我这儿有",
    "start": 135.903,
    "end": 136.763,
    "speaker": "邱",
    "shot": "34"
  },
  {
    "text": "快去吧",
    "start": 141.112,
    "end": 142.052,
    "speaker": "邱",
    "shot": "36"
  },
  {
    "text": "别迟了",
    "start": 142.082,
    "end": 143.012,
    "speaker": "邱",
    "shot": "36"
  },
  {
    "text": "这两根柱子挪一下",
    "start": 164.266,
    "end": 165.821,
    "speaker": "工作人员",
    "shot": "42"
  },
  {
    "text": "去车站就不用绕了",
    "start": 166.616,
    "end": 168.876,
    "speaker": "工作人员",
    "shot": "42"
  },
  {
    "text": "这回行了吧",
    "start": 193.915,
    "end": 194.995,
    "speaker": "店主",
    "shot": "52"
  },
  {
    "text": "让她也试试",
    "start": 195.495,
    "end": 196.805,
    "speaker": "邱",
    "shot": "52"
  },
  {
    "text": "这里转不过来",
    "start": 202.882,
    "end": 204.152,
    "speaker": "来客",
    "shot": "53"
  },
  {
    "text": "今天不用接孩子",
    "start": 252.267,
    "end": 254.027,
    "speaker": "邱",
    "shot": "68"
  },
  {
    "text": "今天他爸接",
    "start": 254.182,
    "end": 255.767,
    "speaker": "徐",
    "shot": "68"
  },
  {
    "text": "这袖子好看",
    "start": 256.333,
    "end": 257.903,
    "speaker": "徐",
    "shot": "69"
  },
  {
    "text": "转过去",
    "start": 258.832,
    "end": 259.54699999999997,
    "speaker": "徐",
    "shot": "70"
  },
  {
    "text": "我看看后面",
    "start": 259.582,
    "end": 260.712,
    "speaker": "徐",
    "shot": "70"
  }
]